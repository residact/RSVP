# Copie ce fichier en .env puis remplis-le : cp .env.example .env
# Jeton d'accès à l'interface, à l'API REST et au serveur MCP.
# Génère-en un avec : openssl rand -base64 24 | tr '+/' '-_' | tr -d '='
RSVP_TOKEN=
# Adresse https publique si tu exposes le port (tunnel) : sert aux liens du MCP.
RSVP_PUBLIC_URL=
# Port publié sur la machine hôte.
PORT=8787
