{
  "manifest_version": 3,
  "name": "RSVP Reader",
  "version": "1.0.0",
  "description": "Lis le texte sélectionné (ex. réponses de Claude) en RSVP, un mot à la fois.",
  "permissions": ["contextMenus", "storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "commands": {
    "start-rsvp": {
      "suggested_key": { "default": "Alt+R" },
      "description": "Lire la sélection en RSVP"
    }
  }
}
