{
  "name": "rsvp-reader",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Lecteur RSVP auto-hébergé : interface web, API REST, serveur MCP et bibliothèque de livres (Bun + TypeScript)",
  "scripts": {
    "dev": "bun run build:web && bun --watch src/server/index.ts",
    "build:web": "bun build src/web/index.html --outdir dist/web --minify && cp src/web/static/* dist/web/",
    "start": "bun src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "skills:install": "bun skills/install.ts",
    "podman:install": "bun podman/install.ts",
    "docker:up": "docker compose -f docker/docker-compose.yml --env-file .env up -d --build",
    "docker:down": "docker compose -f docker/docker-compose.yml --env-file .env down",
    "docker:logs": "docker compose -f docker/docker-compose.yml --env-file .env logs -f rsvp"
  },
  "dependencies": {
    "@lingo-reader/mobi-parser": "^0.4.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fast-xml-parser": "^5.0.0",
    "fflate": "^0.8.2",
    "node-html-parser": "^7.0.0",
    "unpdf": "^1.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
